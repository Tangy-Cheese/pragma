fn sum_squares:int (n:int){
    s = 0
    parallel i in 0..n {
        s += i*i
    }
    return s
}

fn factorial:int (n:int){
    p = 1
    for i in 1..n+1 {
        p *= i
    }
    return p
}

fn mod_checksum:int (n:int, k:int){
    s = 0
    parallel i in 0..n {
        s += i % k
    }
    return s
}

fn prefix_sum:int (n:int){
    a = alloc(int, n)
    a[0] = 0
    for i in 1..n {
        a[i] = a[i-1] + i
    }
    return a[n-1]
}

fn dot:float (n:int){
    x = alloc(float, n)
    y = alloc(float, n)
    parallel i in 0..n {
        x[i] = 1.5
        y[i] = 2.0
    }
    s = 0.0
    parallel i in 0..n {
        s += x[i]*y[i]
    }
    return s
}

fn saxpy:float (n:int){
    x = alloc(float, n)
    y = alloc(float, n)
    parallel i in 0..n {
        x[i] = 1.0
        y[i] = 0.5
    }
    parallel i in 0..n {
        y[i] += 2.5*x[i]
    }
    return y[n-1]
}

fn stencil:float (n:int){
    a = alloc(float, n)
    b = alloc(float, n)
    parallel i in 0..n {
        a[i] = 3.0
    }
    parallel i in 1..n-1 {
        b[i] = a[i-1] + a[i] + a[i+1]
    }
    return b[1]
}

fn matvec:int (n:int){
    m = alloc(int, n*n)
    x = alloc(int, n)
    y = alloc(int, n)
    parallel i in 0..n {
        x[i] = 1
        y[i] = 0
        for j in 0..n {
            m[i*n+j] = i+j
        }
    }
    parallel i in 0..n {
        for j in 0..n {
            y[i] += m[i*n+j]*x[j]
        }
    }
    return y[n-1]
}

n = 10
out sum_squares(n)
out factorial(n)
out mod_checksum(n, 3)
out prefix_sum(n)
out dot(n)
out saxpy(n)
out stencil(n)
out matvec(n)
